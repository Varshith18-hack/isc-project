# Environment Configuration Template
# Copy this file to '.env' for local configuration
# NEVER commit the actual '.env' file containing real secret keys to source control!

# Application Environment: 'development', 'staging', or 'production'
# In production, DEMO_MODE is strictly disabled, Quick Persona Switcher is hidden,
# and initial default accounts are never auto-seeded.
APP_ENV=development

# Demo Mode: 'true' enables student/evaluator demonstration conveniences (development only).
DEMO_MODE=true

# 256-bit Hex-encoded Master Encryption Key (64 hex characters)
# If left blank, the application will automatically generate and securely persist a key locally.
MED_DEVICE_MASTER_KEY=

# Dedicated 256-bit Hex-encoded HMAC Authentication Key (optional override)
MED_DEVICE_HMAC_KEY=

# Configurable Demo User Credentials (Development / Evaluation Mode Only)
# In local development, specify your own passwords in .env.
# Replace [REDACTED] placeholders with strong passwords compliant with PASSWORD_POLICY.
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=[REDACTED]

DEMO_DOCTOR_USERNAME=dr_smith
DEMO_DOCTOR_PASSWORD=[REDACTED]

DEMO_NURSE_USERNAME=nurse_clara
DEMO_NURSE_PASSWORD=[REDACTED]

DEMO_AUDITOR_USERNAME=auditor_davis
DEMO_AUDITOR_PASSWORD=[REDACTED]
